{
  "name": "guardrails-from-scratch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx packages/api/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chokidar": "^4.0.3",
    "compromise": "^14.14.4",
    "express": "^5.1.0",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.18",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}